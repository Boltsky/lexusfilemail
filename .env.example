# ==============================================================================
# LexusMail Platform Environment Configuration
# ==============================================================================

# Application & Environment
NODE_ENV=production
PORT=5000
APP_URL=https://lexusmail.onrender.com

# Cryptography & Security Secrets
# Generate random 64-character hex strings: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_char_string
SESSION_SECRET=replace_with_another_secure_random_string

# Database Configuration (PostgreSQL on Render.com)
DATABASE_URL=postgresql://lexusmail_user:password@dpg-host.oregon-postgres.render.com/lexusmail
DATABASE_SSL=true

# Storage Engine Configuration
# 'google_drive' (Production) | 'local' (Offline / Testing) | 'auto'
STORAGE_PROVIDER=google_drive

# Google Drive API Configuration
# Option A: Service Account JSON (Recommended for Central Storage)
# Either paste the raw JSON string or provide path to secret file mounted on Render:
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"lexusmail-prod","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"lexusmail-sa@lexusmail-prod.iam.gserviceaccount.com"}

# Google Shared Drive ID (Optional, for Google Workspace Shared Drives)
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Root Folder in Google Drive (created automatically if missing)
GOOGLE_DRIVE_ROOT_FOLDER=LexusMail

# Option B: Google OAuth 2.0 Client (Alternative to Service Account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Email Notification Provider ('resend' | 'sendgrid' | 'smtp' | 'console')
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=LexusMail <transfers@lexusmail.com>

# SMTP Configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Transfer & File Limits
MAX_UPLOAD_SIZE_BYTES=5368709120 # 5 GB default (250 GB for Pro)
MAX_FILES_PER_TRANSFER=100
DEFAULT_EXPIRATION_DAYS=7
MAX_EXPIRATION_DAYS=30
ALLOW_GUEST_TRANSFERS=true

# Chunk Size for Resumable Upload Streaming (in Bytes, multiple of 256KB)
CHUNK_SIZE_BYTES=5242880 # 5 MB chunks

# Initial Administrative Seed Account
ADMIN_EMAIL=admin@lexusmail.com
ADMIN_PASSWORD=LexusAdmin2026!
ADMIN_NAME=LexusMail Administrator
